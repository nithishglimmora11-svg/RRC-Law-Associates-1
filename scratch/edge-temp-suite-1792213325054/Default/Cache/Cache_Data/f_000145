/* ==========================================================================
   RRC LAW ASSOCIATES — OCI SERVICE PAGE SCOPED STYLES
   Scope: Exclusively targeted to OCI content sections (.oci-*)
   Preserves shared website Header and Footer completely intact.
   Visual Reference: Manager-approved UI/UX screenshot
   Content Reference: 1-OCI.docx
   Research References: USWDS, GOV.UK type scale, W3C WCAG 1.4.4 text resize
   ========================================================================== */

:root {
  /* Brand Color Palette */
  --oci-navy-darkest: #06111f;
  --oci-navy-deep: #0b1d33;
  --oci-navy-mid: #132a48;
  --oci-gold: #c9a24d;
  --oci-gold-light: #dfbe72;
  --oci-gold-dark: #7c5914;
  --oci-gold-bg: rgba(201, 162, 77, 0.08);
  --oci-gold-border: rgba(201, 162, 77, 0.28);
  --oci-cream-bg: #f9f7f3;
  --oci-cream-subtle: #f5f2eb;
  --oci-card-white: #ffffff;
  --oci-border-light: #e7e2d7;
  --oci-border-card: #eae5dc;
  --oci-text-dark: #0f172a;
  --oci-text-body: #1e293b;
  --oci-text-muted: #334155;
  --oci-text-light: #f1f5f9;
  --oci-shadow-sm: 0 2px 8px rgba(11, 29, 51, 0.04);
  --oci-shadow-md: 0 8px 24px rgba(11, 29, 51, 0.06);
  --oci-shadow-hover: 0 12px 32px rgba(11, 29, 51, 0.12);
  --oci-radius-sm: 6px;
  --oci-radius-md: 10px;
  --oci-radius-lg: 14px;

  /* Scoped Responsive Typography Scale (rem-based, USWDS & GOV.UK Scale) */
  --oci-font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
  --oci-font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* Headings: Fluid clamp with responsive boundaries */
  --oci-fs-h1: clamp(2rem, 3.2vw + 1rem, 3rem);              /* 32px mobile - 48px desktop */
  --oci-fs-h2: clamp(1.625rem, 1.4vw + 1.2rem, 2.0625rem);   /* 26px mobile - 33px desktop */
  --oci-fs-h3: clamp(1.25rem, 0.8vw + 1.05rem, 1.4375rem);  /* 20px mobile - 23px desktop */
  --oci-fs-h4: 1.0625rem;                                    /* 17px */
  --oci-fs-h5: 1rem;                                         /* 16px */

  /* Body & Paragraph Scale */
  --oci-fs-lead: 1.125rem;                                   /* 18px */
  --oci-fs-body: 1.0625rem;                                  /* 17px */
  --oci-fs-body-sm: 0.96875rem;                              /* 15.5px */
  --oci-fs-caption: 0.90625rem;                               /* 14.5px */
  --oci-fs-eyebrow: 0.8125rem;                               /* 13px */
  --oci-fs-meta: 0.75rem;                                    /* 12px */

  /* Research-Based Line Heights */
  --oci-lh-tight: 1.18;
  --oci-lh-heading: 1.28;
  --oci-lh-subheading: 1.34;
  --oci-lh-body: 1.68;
  --oci-lh-body-sm: 1.6;
}

.oci-serif {
  font-family: var(--oci-font-serif);
}

/* --------------------------------------------------------------------------
   GLOBAL SCOPED RESETS & READABILITY ENFORCEMENT ON LIGHT SECTIONS
   Counteracts style.css line 343: p { color: rgba(255,255,255,0.8); }
   Guarantees all text on light cream/white backgrounds is rich, dark, and high-contrast.
   Explicitly scoped to the light content sections so dark banners and footer are never clobbered.
   -------------------------------------------------------------------------- */
.oci-highlights-strip p,
.oci-services-section p,
.oci-comprehensive-services p,
.oci-intro-counsel p,
.oci-ancestry-section p,
.oci-approach-section p,
.oci-positioning-section p,
.oci-guides-section p {
  color: var(--oci-text-body) !important;
  max-width: none;
  margin-bottom: 0;
}

.oci-services-section h1, .oci-services-section h2, .oci-services-section h3, .oci-services-section h4, .oci-services-section h5,
.oci-comprehensive-services h1, .oci-comprehensive-services h2, .oci-comprehensive-services h3, .oci-comprehensive-services h4, .oci-comprehensive-services h5,
.oci-ancestry-section h1, .oci-ancestry-section h2, .oci-ancestry-section h3, .oci-ancestry-section h4, .oci-ancestry-section h5,
.oci-approach-section h1, .oci-approach-section h2, .oci-approach-section h3, .oci-approach-section h4, .oci-approach-section h5,
.oci-positioning-section h1, .oci-positioning-section h2, .oci-positioning-section h3, .oci-positioning-section h4, .oci-positioning-section h5,
.oci-guides-section h1, .oci-guides-section h2, .oci-guides-section h3, .oci-guides-section h4, .oci-guides-section h5 {
  color: var(--oci-navy-deep) !important;
}

/* --------------------------------------------------------------------------
   SECTION B: HERO BANNER
   Screenshot match: Dark navy background, text on left, archival imagery on right
   Padded below the fixed 122px topbar + header
   -------------------------------------------------------------------------- */
.oci-hero-section {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  min-height: 550px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  background-color: var(--oci-navy-deep);
  background-image: 
    linear-gradient(90deg, #071526 0%, rgba(11, 29, 51, 0.98) 45%, rgba(11, 29, 51, 0.72) 70%, rgba(11, 29, 51, 0.35) 100%),
    url('assets/images/oci-hero-bg.jpg');
  background-position: center right;
  background-size: cover;
  background-repeat: no-repeat;
  color: #ffffff;
  padding-top: 136px; /* Offset for 42px topbar + 80px fixed header + 14px buffer */
  padding-bottom: 44px;
}

/* Background video media container matching RRC Law Academy hero architecture */
.oci-hero-video-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.oci-hero-video-wrapper {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 1;
  transition: opacity 900ms cubic-bezier(0.22, 0.61, 0.21, 1);
  will-change: opacity;
  pointer-events: none;
}

.oci-hero-video-wrapper.is-active {
  opacity: 1;
  z-index: 2;
}

.oci-hero-video-wrapper.is-incoming {
  opacity: 1;
  z-index: 3;
}

.oci-hero-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  pointer-events: none;
}

.oci-hero-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 4;
  background: linear-gradient(
    90deg,
    rgba(5, 17, 35, 0.82),
    rgba(5, 17, 35, 0.35)
  );
  pointer-events: none;
}

.oci-hero-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 40%, rgba(201, 162, 77, 0.08) 0%, transparent 60%);
  pointer-events: none;
  z-index: 4;
}

.oci-hero-section > .container {
  position: relative;
  z-index: 5;
  width: 100%;
}

.oci-hero-content {
  position: relative;
  z-index: 5;
  max-width: 640px;
}

@media (prefers-reduced-motion: reduce) {
  .oci-hero-video-media {
    display: none !important;
  }
}

.oci-badge-eyebrow {
  display: inline-block;
  font-size: var(--oci-fs-eyebrow);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--oci-gold-dark);
  margin-bottom: 12px;
}

.oci-hero-section .oci-badge-eyebrow {
  color: var(--oci-gold) !important;
}

.oci-hero-section .oci-hero-title,
.oci-hero-title {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h1);
  font-weight: 700;
  line-height: var(--oci-lh-tight);
  color: #ffffff !important;
  margin-bottom: 16px;
  letter-spacing: -0.015em;
}

.oci-hero-section .oci-hero-subtitle,
.oci-hero-subtitle {
  font-size: var(--oci-fs-lead);
  line-height: var(--oci-lh-body);
  color: rgba(255, 255, 255, 0.95) !important;
  margin-bottom: 24px;
  max-width: 560px;
}

.oci-hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
}

.oci-btn-primary {
  background-color: var(--oci-gold);
  color: #000000;
  font-weight: 600;
  font-size: 1rem;
  padding: 12px 26px;
  border-radius: var(--oci-radius-sm);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  transition: all 0.25s ease;
  border: 1px solid var(--oci-gold);
}

.oci-btn-primary:hover,
.oci-btn-primary:focus {
  background-color: var(--oci-gold-dark);
  color: #000000;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(201, 162, 77, 0.35);
}

.oci-btn-secondary {
  color: #ffffff;
  font-weight: 500;
  font-size: 0.96875rem;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: color 0.2s ease, transform 0.2s ease;
  padding: 11px 16px;
}

.oci-btn-secondary:hover,
.oci-btn-secondary:focus {
  color: var(--oci-gold);
  transform: translateX(3px);
}

/* --------------------------------------------------------------------------
   SECTION C: FOUR SERVICE HIGHLIGHTS STRIP
   Screenshot match: Cream/light strip below hero with 4 horizontal items
   -------------------------------------------------------------------------- */
.oci-highlights-strip {
  background-color: var(--oci-cream-bg);
  border-bottom: 1px solid var(--oci-border-light);
  padding: 14px 0;
}

.oci-highlight-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 14px;
  border-right: 1px solid var(--oci-border-light);
  transition: transform 0.2s ease;
}

.oci-highlight-item:last-child {
  border-right: none;
}

.oci-highlight-icon {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  border-radius: var(--oci-radius-sm);
  background-color: rgba(201, 162, 77, 0.12);
  color: var(--oci-gold-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.05rem;
}

.oci-highlight-text h4 {
  font-size: var(--oci-fs-h5);
  font-weight: 700;
  color: var(--oci-navy-deep);
  margin: 0 0 2px 0;
  letter-spacing: -0.01em;
  line-height: 1.3;
}

.oci-highlight-text p {
  font-size: var(--oci-fs-caption);
  color: var(--oci-text-muted) !important;
  margin: 0;
  line-height: 1.35;
}

/* --------------------------------------------------------------------------
   SUBSTANTIVE LEGAL COUNSEL (DOCX Section 1)
   Integrated within Comprehensive Practice Scope
   -------------------------------------------------------------------------- */
.oci-intro-counsel {
  background: #ffffff;
  border: 1px solid var(--oci-border-card);
  border-radius: var(--oci-radius-sm);
  padding: 16px 20px;
  margin-bottom: 18px;
}

.oci-intro-title {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h2);
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-heading);
}

.oci-intro-lead {
  font-size: var(--oci-fs-lead);
  font-weight: 600;
  color: var(--oci-navy-deep) !important;
  line-height: 1.45;
  margin-bottom: 8px;
}

.oci-intro-p {
  font-size: var(--oci-fs-body);
  color: var(--oci-text-body) !important;
  line-height: var(--oci-lh-body);
  margin-bottom: 0;
}

/* --------------------------------------------------------------------------
   SECTION D: THREE MAIN SERVICE CARDS
   Screenshot match: 3 prominent light cards immediately following strip
   -------------------------------------------------------------------------- */
.oci-services-section {
  padding: 28px 0 32px 0;
  background-color: #ffffff;
}

.oci-service-card {
  background: #ffffff;
  border: 1px solid var(--oci-border-card);
  border-radius: var(--oci-radius-md);
  padding: 18px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--oci-shadow-sm);
  text-decoration: none;
  color: inherit;
  height: 100%;
}

.oci-service-card:hover {
  transform: translateY(-3px);
  border-color: var(--oci-gold);
  box-shadow: var(--oci-shadow-hover);
  color: inherit;
}

.oci-service-card-left {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.oci-service-icon-box {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 8px;
  background-color: var(--oci-cream-subtle);
  border: 1px solid rgba(201, 162, 77, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--oci-gold-dark);
  font-size: 1.25rem;
  transition: background-color 0.25s ease, color 0.25s ease;
}

.oci-service-card:hover .oci-service-icon-box {
  background-color: var(--oci-gold);
  color: #000000;
}

.oci-service-card-body h3 {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h3);
  font-weight: 700;
  color: var(--oci-navy-deep);
  margin: 0 0 4px 0;
  line-height: var(--oci-lh-subheading);
}

.oci-service-card-body p {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-muted) !important;
  margin: 0;
  line-height: var(--oci-lh-body-sm);
}

.oci-service-card-arrow {
  color: #94a3b8;
  font-size: 1.125rem;
  flex-shrink: 0;
  transition: transform 0.25s ease, color 0.25s ease;
}

.oci-service-card:hover .oci-service-card-arrow {
  transform: translateX(4px);
  color: var(--oci-gold-dark);
}

/* Comprehensive DOCX Service Areas Breakdown */
.oci-comprehensive-services {
  margin-top: 22px;
  background: var(--oci-cream-bg);
  border: 1px solid var(--oci-border-light);
  border-radius: var(--oci-radius-md);
  padding: 22px 24px;
}

.oci-comprehensive-header {
  border-bottom: 1px solid var(--oci-border-light);
  padding-bottom: 10px;
  margin-bottom: 16px;
}

.oci-comprehensive-title {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h3);
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-subheading);
}

.oci-comprehensive-desc {
  font-size: var(--oci-fs-caption);
  color: var(--oci-text-muted) !important;
  line-height: 1.45;
}

.oci-btn-sm-enquire {
  font-size: 0.875rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: var(--oci-radius-sm);
}

.oci-comprehensive-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 12px;
}

.oci-subservice-item {
  background: #ffffff;
  border: 1px solid var(--oci-border-card);
  border-radius: 8px;
  padding: 14px 16px;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.oci-subservice-item:hover {
  border-color: var(--oci-gold);
  transform: translateY(-2px);
}

.oci-subservice-item h4 {
  font-size: var(--oci-fs-h4);
  font-weight: 700;
  color: var(--oci-navy-deep);
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 8px;
  line-height: 1.35;
}

.oci-subservice-item h4 i {
  color: var(--oci-gold);
  font-size: 0.9375rem;
}

.oci-subservice-item p {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-body) !important;
  margin: 0;
  line-height: var(--oci-lh-body-sm);
}

.oci-disclaimer-notice {
  margin-top: 14px;
  padding: 10px 14px;
  border-left: 3px solid var(--oci-gold);
  background: rgba(201, 162, 77, 0.08);
  border-radius: 0 var(--oci-radius-sm) var(--oci-radius-sm) 0;
  font-size: var(--oci-fs-caption);
  color: var(--oci-text-body) !important;
  line-height: 1.5;
}

/* --------------------------------------------------------------------------
   SECTION E: ANCESTRY RELATIONSHIP DIAGRAM
   Layout: Header + Statutory Rule Card on top row; Diagram on dedicated row
   -------------------------------------------------------------------------- */
.oci-ancestry-section {
  padding: 28px 0;
  background-color: #ffffff;
}

.oci-ancestry-card {
  background: var(--oci-cream-bg);
  border: 1px solid var(--oci-border-light);
  border-radius: var(--oci-radius-lg);
  padding: 24px 24px;
}

/* Dedicated CSS Grid Layout */
.oci-ancestry-layout {
  display: grid;
  grid-template-columns: 1fr;
  grid-template-areas:
    "header"
    "diagram"
    "callout";
  gap: 18px;
  align-items: center;
}

@media (min-width: 992px) {
  .oci-ancestry-layout {
    grid-template-columns: 1.35fr 1fr;
    grid-template-areas:
      "header callout"
      "diagram diagram";
    gap: 18px 22px;
    align-items: center;
  }
}

.oci-ancestry-header-area {
  grid-area: header;
  min-width: 0;
}

.oci-ancestry-callout-area {
  grid-area: callout;
  min-width: 0;
}

.oci-ancestry-diagram-area {
  grid-area: diagram;
  min-width: 0;
  width: 100%;
}

.oci-ancestry-header h2 {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h2);
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-heading);
  margin-bottom: 8px;
}

.oci-ancestry-header p {
  font-size: var(--oci-fs-body);
  color: var(--oci-text-body) !important;
  line-height: var(--oci-lh-body);
  margin-bottom: 0;
}

/* Ancestry Chain Progression Flow */
.oci-chain-flow {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: clamp(8px, 1.5vw, 20px);
  width: 100%;
  padding: 4px 0;
}

.oci-chain-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 0 1 165px;
  min-width: 0;
  max-width: 175px;
}

.oci-chain-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  margin-bottom: 6px;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.06);
  transition: transform 0.25s ease;
  flex-shrink: 0;
}

.oci-chain-node:hover .oci-chain-avatar {
  transform: scale(1.06);
}

.oci-avatar-applicant {
  background-color: #2b394e;
  color: #ffffff;
}

.oci-avatar-ancestor {
  background-color: #c4a47c;
  color: #ffffff;
}

.oci-chain-title {
  font-size: var(--oci-fs-body-sm);
  font-weight: 700;
  color: var(--oci-navy-deep);
  margin-bottom: 2px;
  white-space: nowrap;
  line-height: 1.3;
}

.oci-chain-desc {
  font-size: 0.875rem;
  color: var(--oci-text-muted) !important;
  line-height: 1.35;
  max-width: 150px;
}

.oci-chain-arrow {
  color: #94a3b8;
  font-size: 1.15rem;
  margin-top: 15px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.oci-ancestry-callout {
  background: #ffffff;
  border: 1px solid var(--oci-border-card);
  border-radius: var(--oci-radius-md);
  padding: 14px 16px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  height: 100%;
}

.oci-ancestry-callout-icon {
  color: var(--oci-gold-dark);
  font-size: 1.5rem;
  flex-shrink: 0;
  margin-top: 2px;
}

.oci-ancestry-callout p {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-body) !important;
  line-height: 1.55;
  margin: 0;
}

/* Documentary Records Breakdown (DOCX Section 3) */
.oci-records-details {
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px dashed var(--oci-border-light);
}

.oci-records-heading {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h3);
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-subheading);
  margin-bottom: 8px;
}

.oci-records-p {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-body) !important;
  line-height: var(--oci-lh-body-sm);
  margin-bottom: 8px;
}

.oci-records-p-sub {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-muted) !important;
  line-height: var(--oci-lh-body-sm);
  margin-bottom: 0;
}

.oci-records-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 10px 0 0 0;
}

.oci-records-list li {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-body) !important;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  background: #ffffff;
  padding: 8px 12px;
  border-radius: var(--oci-radius-sm);
  border: 1px solid var(--oci-border-light);
  line-height: 1.5;
}

.oci-records-list li i {
  color: var(--oci-gold);
  margin-top: 3px;
  flex-shrink: 0;
  font-size: 1rem;
}

/* --------------------------------------------------------------------------
   SECTION F: OUR APPROACH
   Screenshot match: Heading left, 3 gold numbered circles with subtle arrows
   -------------------------------------------------------------------------- */
.oci-approach-section {
  padding: 28px 0;
  background-color: #ffffff;
}

.oci-approach-title {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h2);
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-heading);
  margin-bottom: 6px;
}

.oci-approach-desc {
  font-size: var(--oci-fs-body);
  color: var(--oci-text-muted) !important;
  line-height: var(--oci-lh-body);
}

.oci-approach-steps {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.oci-step-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  flex: 1;
}

.oci-step-number {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: #9d7b38;
  color: #ffffff;
  font-weight: 700;
  font-size: 0.95rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 3px 8px rgba(157, 123, 56, 0.25);
}

.oci-step-text h4 {
  font-family: var(--oci-font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--oci-navy-deep);
  margin: 0 0 3px 0;
  line-height: 1.32;
}

.oci-step-text p {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-body) !important;
  line-height: var(--oci-lh-body-sm);
  margin: 0;
}

.oci-step-arrow {
  color: #94a3b8;
  font-size: 1.15rem;
  margin-top: 8px;
  flex-shrink: 0;
}

/* Full 6-Step Roadmap (Preserving DOCX Section 4) */
.oci-full-roadmap {
  margin-top: 20px;
  background-color: var(--oci-cream-bg);
  border: 1px solid var(--oci-border-light);
  border-radius: var(--oci-radius-md);
  padding: 18px 20px;
}

.oci-roadmap-title {
  font-family: var(--oci-font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-subheading);
}

.oci-roadmap-subtitle {
  font-size: var(--oci-fs-caption);
  color: var(--oci-text-muted) !important;
}

.oci-roadmap-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 12px;
  margin-top: 12px;
}

.oci-roadmap-card {
  background: #ffffff;
  border: 1px solid var(--oci-border-card);
  border-radius: 8px;
  padding: 12px 14px;
}

.oci-roadmap-card-tag {
  font-size: var(--oci-fs-meta);
  font-weight: 700;
  text-transform: uppercase;
  color: var(--oci-gold-dark);
  letter-spacing: 0.8px;
  margin-bottom: 3px;
}

.oci-roadmap-card h5 {
  font-size: var(--oci-fs-h5);
  font-weight: 700;
  color: var(--oci-navy-deep);
  margin-bottom: 4px;
  line-height: 1.35;
}

.oci-roadmap-card p {
  font-size: 0.90625rem;
  color: var(--oci-text-body) !important;
  margin: 0;
  line-height: 1.55;
}

/* --------------------------------------------------------------------------
   DOCX SECTION 5 & 7: WHO SHOULD CONTACT & ROUTINE VS PROPOSED POSITIONING
   -------------------------------------------------------------------------- */
.oci-positioning-section {
  padding: 28px 0;
  background-color: var(--oci-cream-bg);
  border-top: 1px solid var(--oci-border-light);
  border-bottom: 1px solid var(--oci-border-light);
}

.oci-audience-card {
  background: #ffffff;
  border: 1px solid var(--oci-border-card);
  border-radius: var(--oci-radius-md);
  padding: 20px 22px;
  height: 100%;
}

.oci-audience-title {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h3);
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-subheading);
  margin-bottom: 12px;
}

.oci-audience-list {
  list-style: none;
  padding: 0;
  margin: 12px 0 0 0;
}

.oci-audience-list li {
  font-size: var(--oci-fs-body-sm);
  color: var(--oci-text-body) !important;
  margin-bottom: 8px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  line-height: 1.55;
}

.oci-audience-list li i {
  color: var(--oci-gold);
  font-size: 0.9375rem;
  margin-top: 3px;
  flex-shrink: 0;
}

.oci-compare-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin-top: 12px;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid var(--oci-border-card);
}

.oci-compare-table th {
  background-color: var(--oci-navy-deep);
  color: #ffffff;
  font-size: 0.90625rem;
  font-weight: 600;
  padding: 9px 12px;
  text-align: left;
  line-height: 1.4;
}

.oci-compare-table td {
  padding: 9px 12px;
  font-size: var(--oci-fs-body-sm);
  border-top: 1px solid var(--oci-border-light);
  background-color: #ffffff;
  color: var(--oci-text-body) !important;
  line-height: 1.5;
}

.oci-compare-table tr:nth-child(even) td {
  background-color: #fcfbf9;
}

.oci-compare-table td:last-child {
  font-weight: 600;
  color: var(--oci-navy-deep) !important;
  border-left: 2px solid var(--oci-gold);
}

/* --------------------------------------------------------------------------
   SECTION G: OCI LEGAL GUIDES
   Screenshot match: Heading on left, 3 featured cards with image on top
   -------------------------------------------------------------------------- */
.oci-guides-section {
  padding: 28px 0;
  background-color: #ffffff;
}

.oci-guides-header h2 {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h2);
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: var(--oci-lh-heading);
  margin-bottom: 6px;
}

.oci-guides-header p {
  font-size: var(--oci-fs-body);
  color: var(--oci-text-muted) !important;
  line-height: var(--oci-lh-body);
  margin-bottom: 14px;
}

.oci-guide-card {
  background: #ffffff;
  border: 1px solid var(--oci-border-card);
  border-radius: var(--oci-radius-md);
  overflow: hidden;
  transition: all 0.28s ease;
  box-shadow: var(--oci-shadow-sm);
  display: flex;
  flex-direction: column;
  height: 100%;
  text-decoration: none;
  color: inherit;
}

.oci-guide-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--oci-shadow-hover);
  border-color: var(--oci-gold);
  color: inherit;
}

.oci-guide-img-wrap {
  position: relative;
  width: 100%;
  height: 135px;
  overflow: hidden;
  background-color: #e2e8f0;
}

.oci-guide-img-wrap img {
  width: 100%;
  height: 135px;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.oci-guide-card:hover .oci-guide-img-wrap img {
  transform: scale(1.05);
}

.oci-guide-body {
  padding: 14px 16px 16px 16px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.oci-guide-category {
  font-size: var(--oci-fs-meta);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--oci-gold-dark);
  margin-bottom: 4px;
}

.oci-guide-title {
  font-family: var(--oci-font-serif);
  font-size: 1.1875rem;
  font-weight: 700;
  color: var(--oci-navy-deep);
  line-height: 1.34;
  margin-bottom: 10px;
  flex-grow: 1;
}

.oci-guide-link {
  font-size: 0.90625rem;
  font-weight: 600;
  color: var(--oci-navy-deep);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: auto;
  transition: color 0.2s ease, transform 0.2s ease;
}

.oci-guide-card:hover .oci-guide-link {
  color: var(--oci-gold-dark);
  transform: translateX(4px);
}

/* --------------------------------------------------------------------------
   SECTION H: CONSULTATION CTA BANNER
   Screenshot match: Full width banner with background image, dark overlay, gold CTA
   -------------------------------------------------------------------------- */
.oci-cta-banner {
  position: relative;
  background-color: var(--oci-navy-deep);
  background-image: 
    linear-gradient(90deg, rgba(7, 21, 38, 0.94) 0%, rgba(11, 29, 51, 0.90) 60%, rgba(11, 29, 51, 0.85) 100%),
    url('assets/images/oci-consultation-bg.jpg');
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  color: #ffffff;
  padding: 30px 0;
  margin-top: 0;
}

.oci-cta-banner-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.oci-cta-banner h2,
.oci-cta-text h2 {
  font-family: var(--oci-font-serif);
  font-size: var(--oci-fs-h2);
  font-weight: 700;
  color: #ffffff !important;
  margin: 0 0 6px 0;
  line-height: var(--oci-lh-heading);
}

.oci-cta-banner p,
.oci-cta-text p {
  font-size: var(--oci-fs-body);
  color: rgba(255, 255, 255, 0.95) !important;
  margin: 0;
  max-width: 660px;
  line-height: var(--oci-lh-body);
}

.oci-btn-banner-cta {
  background-color: var(--oci-gold);
  color: var(--oci-navy-deep) !important;
  font-weight: 700;
  font-size: 1rem;
  padding: 12px 26px;
  border-radius: var(--oci-radius-sm);
  text-decoration: none;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.25s ease;
  border: 1px solid var(--oci-gold);
  flex-shrink: 0;
}

.oci-btn-banner-cta:hover,
.oci-btn-banner-cta:focus {
  background-color: #e2b759;
  color: #000000 !important;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(201, 162, 77, 0.5);
}

/* --------------------------------------------------------------------------
   RESPONSIVE MEDIA QUERIES
   -------------------------------------------------------------------------- */
@media (max-width: 1199px) {
  .oci-step-arrow {
    display: none;
  }
}

@media (max-width: 991px) {
  .oci-hero-section {
    padding-top: 104px;
    padding-bottom: 38px;
    background-image: 
      linear-gradient(180deg, rgba(7, 21, 38, 0.95) 0%, rgba(11, 29, 51, 0.92) 100%),
      url('assets/images/oci-hero-bg.jpg');
    background-position: center;
  }

  .oci-hero-overlay {
    background: linear-gradient(180deg, rgba(7, 21, 38, 0.95) 0%, rgba(11, 29, 51, 0.92) 100%);
  }

  .oci-highlight-item {
    border-right: none;
    border-bottom: 1px solid var(--oci-border-light);
    padding: 12px 6px;
  }

  .oci-highlight-item:last-child {
    border-bottom: none;
  }

  .oci-approach-steps {
    flex-direction: column;
    gap: 20px;
  }

  .oci-cta-banner-content {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 767px) {
  :root {
    --oci-fs-h1: clamp(2rem, 5vw + 1rem, 2.25rem);          /* 32px - 36px */
    --oci-fs-h2: clamp(1.5625rem, 3.5vw + 1rem, 1.75rem);   /* 25px - 28px */
    --oci-fs-h3: clamp(1.25rem, 2.5vw + 0.9rem, 1.375rem);  /* 20px - 22px */
    --oci-fs-body: 1rem;                                     /* 16px */
    --oci-fs-lead: 1.0625rem;                                /* 17px */
  }

  .oci-hero-actions {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .oci-btn-primary {
    width: 100%;
    justify-content: center;
  }

  .oci-btn-secondary {
    padding-left: 0;
  }

  .oci-service-card {
    padding: 22px 18px;
  }

  .oci-ancestry-card {
    padding: 24px 18px;
  }

  .oci-comprehensive-services {
    padding: 22px 16px;
  }
}

@media (max-width: 639px) {
  .oci-chain-flow {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 14px 0;
  }

  .oci-chain-arrow {
    transform: rotate(90deg);
    margin: 4px 0;
  }

  .oci-chain-node {
    max-width: 240px;
  }
}

