            document.addEventListener("DOMContentLoaded", () => {
    const advGrid = document.getElementById("advocatesGrid");
    const advCards = document.querySelectorAll(".advocate-card");
    const advPrevBtn = document.querySelector(".adv-prev");
    const advNextBtn = document.querySelector(".adv-next");

    if (advGrid && advCards.length > 0) {
        let advIndex = 0;
        const advGap = 24; // Matches the gap in CSS
        let autoScrollInterval;

        // Calculate how many cards are visible based on screen width
        function getVisibleCards() {
            if (window.innerWidth > 968) return 3;
            if (window.innerWidth > 768) return 2;
            return 1;
        }

        function updateAdvocateSlider() {
            const visible = getVisibleCards();
            const cardWidth = advCards[0].offsetWidth + advGap;
            advGrid.style.transform = `translateX(-${advIndex * cardWidth}px)`;
        }

        function moveAdvNext() {
            const visible = getVisibleCards();
            // Loop back to start if we reach the end
            if (advIndex >= advCards.length - visible) {
                advIndex = 0;
            } else {
                advIndex++;
            }
            updateAdvocateSlider();
        }

        function moveAdvPrev() {
            const visible = getVisibleCards();
            if (advIndex > 0) {
                advIndex--;
            } else {
                advIndex = advCards.length - visible;
            }
            updateAdvocateSlider();
        }

        // Auto Scroll Management
        function startAdvAutoScroll() {
            stopAdvAutoScroll();
            autoScrollInterval = setInterval(moveAdvNext, 4000); // 4 seconds
        }

        function stopAdvAutoScroll() {
            if (autoScrollInterval) clearInterval(autoScrollInterval);
        }

        // Event Listeners
        advNextBtn?.addEventListener("click", () => {
            moveAdvNext();
            startAdvAutoScroll(); // Reset timer on click
        });

        advPrevBtn?.addEventListener("click", () => {
            moveAdvPrev();
            startAdvAutoScroll();
        });

        // Pause scroll when mouse is over the slider
        advGrid.addEventListener("mouseenter", stopAdvAutoScroll);
        advGrid.addEventListener("mouseleave", startAdvAutoScroll);

        // Responsive handling
        window.addEventListener("resize", () => {
            advIndex = 0; // Reset position on resize to avoid alignment issues
            updateAdvocateSlider();
        });

        // Initial Start
        updateAdvocateSlider();
        startAdvAutoScroll();
    }
});
