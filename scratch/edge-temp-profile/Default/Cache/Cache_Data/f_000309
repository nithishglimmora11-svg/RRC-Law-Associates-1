                                <div id="collapseFaq3" class="accordion-collapse collapse" aria-labelledby="headingFaq3" data-bs-parent="#faqAccordion">
                                    <div class="accordion-body">
                                        OCI cardholders may work in India subject to applicable laws and restrictions. Certain activities require prior permission, and public-service positions may be restricted.
                                    </div>
                                </div>
                            </div>

                            <!-- FAQ 4 -->
                            <div class="accordion-item">
                                <h3 class="accordion-header" id="headingFaq4">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFaq4" aria-expanded="false" aria-controls="collapseFaq4">
                                        4. Can an OCI cardholder buy a house or apartment in India?
                                    </button>
