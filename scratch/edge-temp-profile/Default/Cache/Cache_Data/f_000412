    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Mobile Menu Toggle
            const menuToggle = document.getElementById('menuToggle');
            const mobileMenu = document.getElementById('mobileMenu');
            const closeMenu = document.getElementById('closeMenu');

            if (menuToggle && mobileMenu) {
                menuToggle.addEventListener('click', () => mobileMenu.classList.add('open'));
            }

            if (closeMenu && mobileMenu) {
                closeMenu.addEventListener('click', () => mobileMenu.classList.remove('open'));
            }

            document.querySelectorAll('.m-trigger').forEach(trigger => {
                trigger.addEventListener('click', function(e) {
                    const submenu = this.nextElementSibling;
                    if (!submenu) return;
                    e.preventDefault();
                    const isOpen = submenu.classList.contains('active');
                    document.querySelectorAll('.m-submenu').forEach(m => m.classList.remove('active'));
                    if (!isOpen) submenu.classList.add('active');
                });
            });

            // Interactive Category Filter & Quick Navigation
            const filterButtons = document.querySelectorAll('.cat-filter-btn');
            const categoryCards = document.querySelectorAll('.category-card');
            const categoryBlocks = document.querySelectorAll('.category-group-block');
            const filterBanner = document.getElementById('filterStatusBanner');
            const filterCategoryName = document.getElementById('filterCategoryName');
            const filterCount = document.getElementById('filterCount');
            const filterClearBtn = document.getElementById('filterClearBtn');

            const categoryCounts = {
                'cat-1': { name: 'Category 1: OCI Eligibility, Status and Applications', count: 3 },
                'cat-2': { name: 'Category 2: Indian Ancestry and Family Documentation', count: 3 },
                'cat-3': { name: 'Category 3: OCI Rights, Restrictions and Indian Property', count: 4 },
                'cat-4': { name: 'Category 4: Legal Documentation and OCI Maintenance', count: 3 },
                'cat-5': { name: 'Category 5: OCI Cancellation and Legal Remedies', count: 2 }
            };

            function filterCategory(targetCat, shouldScroll = false) {
                // Update filter buttons
                filterButtons.forEach(btn => {
                    if (btn.getAttribute('data-filter') === targetCat) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });

                // Update category cards active styling
                categoryCards.forEach(card => {
                    if (card.getAttribute('data-category-target') === targetCat) {
                        card.classList.add('active-filter');
                    } else {
                        card.classList.remove('active-filter');
                    }
                });

                if (targetCat === 'all') {
                    // Show all category blocks
                    categoryBlocks.forEach(block => block.style.display = 'block');
                    if (filterBanner) filterBanner.classList.remove('visible');
                } else {
                    // Show only selected category block
                    categoryBlocks.forEach(block => {
                        if (block.getAttribute('data-category-group') === targetCat) {
                            block.style.display = 'block';
                        } else {
                            block.style.display = 'none';
                        }
                    });

                    if (filterBanner && categoryCounts[targetCat]) {
                        filterCategoryName.textContent = categoryCounts[targetCat].name;
                        filterCount.textContent = categoryCounts[targetCat].count;
                        filterBanner.classList.add('visible');
                    }
                }

                if (shouldScroll) {
                    const targetEl = document.getElementById('guides-container');
                    if (targetEl) {
                        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }
            }

            // Bind filter buttons
            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const cat = this.getAttribute('data-filter');
                    filterCategory(cat, false);
                });
            });

            // Bind category cards
            categoryCards.forEach(card => {
                card.addEventListener('click', function () {
                    const cat = this.getAttribute('data-category-target');
                    filterCategory(cat, true);
                });

                card.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });

            // Clear filter button
            if (filterClearBtn) {
                filterClearBtn.addEventListener('click', function () {
                    filterCategory('all', true);
                });
            }
        });
    </script>
