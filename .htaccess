# 3. Internally resolve canonical trailing-slash clean URLs directly to HTML files
RewriteRule ^(customs-show-cause-notice-legal-reply|customs-seizure-release-of-goods|customs-provisional-release-seized-goods|customs-confiscation-redemption-fine-penalties|customs-appeals-cestat-high-courts|customs-investigation-search-summons-rights|customs-gold-jewellery-airports|customs-passenger-baggage-detention-release|customs-duty-demand-limitation-section-28|customs-valuation-related-party-imports|customs-hsn-classification-disputes|customs-refunds-reimports-drawback|customs-restricted-prohibited-goods-import|customs-broker-liability-importer-exporter-compliance|customs-prosecution-arrest-bail)/$ /$1.html [L,NC,QSA]

